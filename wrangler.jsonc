{
  // Fashley Tailor bindings (G1). Resource IDs are identifiers, not secrets.
  "name": "kasalite-technologies-fashley",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fashley-tailor",
      "database_id": "70249e86-5820-4270-8fe1-27b91983185a",
      "migrations_dir": "migrations/tailor"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TAILOR_MEDIA",
      "bucket_name": "fashley-tailor-media"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "CLERK_SECRET_KEY",
      "store_id": "f1a49cc62eaa46cfa793e4de4ed2ec87",
      "secret_name": "CLERK_SECRET_KEY"
    },
    {
      "binding": "META_API_KEY",
      "store_id": "f1a49cc62eaa46cfa793e4de4ed2ec87",
      "secret_name": "META_API_KEY"
    }
  ],
  "workflows": [
    {
      "name": "fashley-tailor-jobs",
      "binding": "TAILOR_WORKFLOW",
      "class_name": "TailorWorkflow",
      "script_name": "fashley-tailor-workflow"
    }
  ]
  // The companion Workflow Worker (workers/tailor-workflow) must be deployed
  // before dispatch succeeds. Clerk and Meta credentials are Worker secrets
  // (cf secrets), never vars in this file.
}
