# Public configuration for the existing Supabase application.
# Copy to .env and replace placeholders. Never use a service-role key here.
SUPABASE_PROJECT_ID=your-project-reference
SUPABASE_URL=https://your-project-reference.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-reference
VITE_SUPABASE_URL=https://your-project-reference.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
